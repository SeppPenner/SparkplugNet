    <ProjectTypeGuids>{11A8DD76-328B-46DF-9F39-F559912D0360};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <ProjectGuid>{123330CC-C481-4E40-9F21-67D0D78CD136}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>SparkplugNet.NanoFramework</RootNamespace>
    <AssemblyName>SparkplugNet.nanoFramework</AssemblyName>
    <TargetFrameworkVersion>v1.0</TargetFrameworkVersion>
    <LangVersion>8.0</LangVersion>
    <NanoPackagesPath Condition="'$(NanoPackagesPath)' == ''">$(MSBuildThisFileDirectory)..\..\packages\</NanoPackagesPath>
