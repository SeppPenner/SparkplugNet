<?xml version="1.0" encoding="utf-8"?>
<!-- The nfproj cannot pack itself, BuildAndPushPackage.bat packs this file with nuget.exe and the GitVersion version of SparkplugNet. -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>SparkplugNet.nanoFramework</id>
        <version>$version$</version>
        <title>SparkplugNet.nanoFramework</title>
        <authors>SeppPenner</authors>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <license type="expression">MIT</license>
        <icon>Icon.png</icon>
        <readme>README.md</readme>
        <projectUrl>https://github.com/SeppPenner/SparkplugNet</projectUrl>
        <repository type="git" url="https://github.com/SeppPenner/SparkplugNet" />
        <description>Sparkplug B Edge Node for .NET nanoFramework over MQTT 3.1.1, supporting the Sparkplug specification versions 2.2 and 3.0.</description>
        <copyright>Copyright © Hämmer Electronics</copyright>
        <tags>nanoFramework C# csharp netnf sparkplug mqtt</tags>
        <!-- Keep these versions in sync with packages.config. -->
        <dependencies>
            <dependency id="nanoFramework.CoreLibrary" version="1.17.12" />
            <dependency id="nanoFramework.Runtime.Events" version="1.11.39" />
            <dependency id="nanoFramework.System.IO.Streams" version="1.1.96" />
            <dependency id="nanoFramework.System.Net" version="1.11.64" />
            <dependency id="nanoFramework.System.Text" version="1.3.42" />
            <dependency id="nanoFramework.System.Threading" version="1.1.52" />
        </dependencies>
    </metadata>
    <files>
        <!-- nanoFramework packages keep their assemblies directly in lib, without a target framework folder. -->
        <file src="bin\Release\SparkplugNet.nanoFramework.dll" target="lib" />
        <file src="bin\Release\SparkplugNet.nanoFramework.pdb" target="lib" />
        <file src="bin\Release\SparkplugNet.nanoFramework.pdbx" target="lib" />
        <file src="bin\Release\SparkplugNet.nanoFramework.pe" target="lib" />
        <file src="README.md" target="" />
        <file src="..\..\Icon.png" target="" />
    </files>
</package>
